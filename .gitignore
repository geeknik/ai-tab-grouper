# Ignore .aider files
.aider*

# Ignore node_modules directory
node_modules/

# Ignore build output
dist/

# Ignore temporary files
*.tmp
*.temp

# Ignore IDE-specific files
.vscode/
.idea/
*.sublime-*
*.swp
*.swo

# Ignore OS-specific files
.DS_Store
Thumbs.db
desktop.ini

# Ignore log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore zip files (often used for packaging extensions)
*.zip

# Ignore test coverage reports
coverage/
.nyc_output/

# Ignore Jest cache
.jest/

# Ignore environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore package manager locks (optional, depends on team preference)
# yarn.lock
# package-lock.json

# Ignore browser extension build artifacts
*.crx
*.pem
*.xpi

# Ignore cache directories
.cache/
.npm/
.eslintcache
